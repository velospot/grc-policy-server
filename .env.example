# ══════════════════════════════════════════════════════════════════════════════
# GRC Policy Server — Environment Configuration
#
# Copy this file to .env and fill in the values for your deployment.
# For offline-only (local Ollama, no Weaviate/Redis) see PRODUCTION.md.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────────
APP_NAME=grc-policy-server
ENVIRONMENT=production
LOG_LEVEL=INFO

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8500
DEBUG=false
API_BEARER_TOKEN=dummy-token
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=false

# ── Storage ────────────────────────────────────────────────────────────────
UPLOAD_ROOT=./data/uploads

# ── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=grc_admin
POSTGRES_PASSWORD=grc_admin
POSTGRES_DB=grc_db
DATABASE_URL=postgresql://grc_admin:grc_admin@localhost:5432/grc_db

# ── Neo4j (optional — disabled by default) ─────────────────────────────────
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password
NEO4J_DATABASE=neo4j

# ── Weaviate (optional — required for hybrid vector search) ─────────────────
# Set COMPARISON_BACKEND=offline to skip Weaviate entirely.
# Vectorizer: Ollama is the only supported vectorizer (HuggingFace removed).
WEAVIATE_URL=http://localhost:8085
WEAVIATE_COLLECTION=PolicyChunk
WEAVIATE_EMBEDDED=false

# ── Ollama (local LLM — chat and embeddings) ────────────────────────────────
# When running Ollama on the host machine (outside Docker):
#   OLLAMA_URL=http://host.docker.internal:11434
# When running Ollama as a Docker container:
#   OLLAMA_URL=http://ollama:11434
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=granite3.3:8b
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
OLLAMA_TIMEOUT_SEC=600
OLLAMA_CONNECT_TIMEOUT_SEC=10
OLLAMA_WRITE_TIMEOUT_SEC=60

# ── LLM backend selection ───────────────────────────────────────────────────
# Sole supported backend: Ollama (local inference, no cloud API required).
# All comparisons, explanations, summaries, and embeddings route through Ollama.
LLM_ENRICHMENT_ENABLED=false

# ══════════════════════════════════════════════════════════════════════════════
# OFFLINE / DEGRADATION SETTINGS  (Phase 1)
# ══════════════════════════════════════════════════════════════════════════════
# COMPARISON_BACKEND controls which comparison engine is used:
#   offline  — PostgreSQL + files + local Ollama. No Weaviate, no Celery.
#   online   — Full stack: Weaviate + LLM + Celery.
#   auto     — Use online when services reachable, degrade to offline otherwise.
COMPARISON_BACKEND=auto

# When OFFLINE_FALLBACK=true, Celery errors and service failures automatically
# fall back to the offline engine rather than returning 5xx errors.
OFFLINE_FALLBACK=true

# Local sentence-transformer model for offline semantic matching.
# Requires ~2.3 GB disk; downloaded on first use.
BGE_M3_MODEL=BAAI/bge-m3

# ══════════════════════════════════════════════════════════════════════════════
# ONTOLOGY CLASSIFICATION  (Phase 3)
# ══════════════════════════════════════════════════════════════════════════════
# When enabled, async (v2) document upload classifies each chunk into the
# 10-type universal compliance ontology. Items with confidence < threshold
# are queued for human review (GET /documents/{id}/review-queue).
ONTOLOGY_CLASSIFICATION_ENABLED=false
ONTOLOGY_CLASSIFIER_URL=             # defaults to OLLAMA_URL when empty
ONTOLOGY_CLASSIFIER_MODEL=           # defaults to OLLAMA_CHAT_MODEL when empty
ONTOLOGY_CONFIDENCE_THRESHOLD=0.70

# ══════════════════════════════════════════════════════════════════════════════
# AUDIT LOG  (Phase 4)
# ══════════════════════════════════════════════════════════════════════════════
# Append-only comparison event log in PostgreSQL (with JSONL file fallback).
# The table is protected by PostgreSQL RULE blocks on UPDATE and DELETE.
AUDIT_LOG_ENABLED=true

# LLM-powered evidence extraction for MODIFIED node pairs.
# Disabled by default — opt-in after confirming LLM endpoint stability.
EVIDENCE_EXTRACTION_ENABLED=false

# ══════════════════════════════════════════════════════════════════════════════
# EXPLANATION AGENT  (Phase 5)
# ══════════════════════════════════════════════════════════════════════════════
# Wraps the LLM client with a focused compliance explanation prompt.
# Used by POST /v4/compare/stream to generate per-diff narrative explanations.
EXPLANATION_AGENT_ENABLED=true

# Token budget per diff explanation. Lower values = faster, less detailed.
# See docs/agentic_limitations.md for guidance on local Ollama hardware.
MAX_EXPLANATION_TOKENS=80

# Number of diffs processed per LLM summary batch (context window management).
EXPLANATION_BATCH_SIZE=10

# ══════════════════════════════════════════════════════════════════════════════
# CIRCUIT BREAKER / HEALTH REGISTRY  (Phase 6)
# ══════════════════════════════════════════════════════════════════════════════
# ServiceHealthRegistry: probes Weaviate, Neo4j, Celery, and LLM periodically.
# In 'auto' mode, failed services trigger automatic degradation to offline engine.
# Status visible at GET /health/services (no auth required).
CIRCUIT_BREAKER_THRESHOLD=3          # consecutive failures before circuit opens
CIRCUIT_BREAKER_TIMEOUT_S=60         # seconds circuit stays open before re-probe

# ══════════════════════════════════════════════════════════════════════════════
# CELERY  (required for /documents/upload/v2 and /v2/compare async endpoints)
# ══════════════════════════════════════════════════════════════════════════════
# When COMPARISON_BACKEND=offline, compare v2 runs synchronously (no Celery needed).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_DEFAULT_QUEUE=grc_policy_server.upload
CELERY_TASK_TIMEOUT_SEC=900
CELERY_TASK_SOFT_TIME_LIMIT_SEC=2700
CELERY_TASK_HARD_TIME_LIMIT_SEC=3600
CELERY_WORKER_PING_TIMEOUT_SEC=1
CELERY_ENFORCE_WORKER_PING=false
CELERY_WORKER_CONCURRENCY=
CELERY_WORKER_POOL=
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=200
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=0
CELERY_BROKER_CONNECTION_RETRY_ON_STARTUP=true
CELERY_BROKER_POOL_LIMIT=10
CELERY_RESULT_EXPIRES_SEC=86400
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_REJECT_ON_WORKER_LOST=true
CELERY_WORKER_DISABLE_RATE_LIMITS=true

# ── Docling accelerator ─────────────────────────────────────────────────────
DOCLING_ACCELERATOR_DEVICE=auto      # auto | cuda | mps | cpu
DOCLING_ACCELERATOR_THREADS=4
DOCLING_CUDA_USE_FLASH_ATTENTION2=false

# Docling two-pass table OCR (opt-in; enable for scanned PDFs with empty cells)
DOCLING_TABLE_OCR_ENABLED=false
DOCLING_TABLE_OCR_MIN_DENSITY=0.3
DOCLING_TABLE_OCR_PAGE_MARGIN=1

# VLM-based table extraction via granite-docling (opt-in)
DOCLING_VLM_ENABLED=false
DOCLING_VLM_MODEL=ibm/granite-docling:258m
DOCLING_VLM_OLLAMA_URL=http://localhost:11434
DOCLING_VLM_TIMEOUT_SEC=300

# ── LLM streaming settings ──────────────────────────────────────────────────
LLM_STREAM_INTER_DIFF_DELAY_MS=0     # set >0 to throttle streaming on slow backends
LLM_STREAM_SEQUENTIAL=false

# ── OCR fallback ────────────────────────────────────────────────────────────
OCR_FALLBACK_ENABLED=true
OCR_FALLBACK_MIN_CHARS_PER_PAGE=80
OCR_FALLBACK_LANGUAGES=eng+deu+fra+spa

# ── Opik LLM observability (opt-in) ────────────────────────────────────────
OPIK_ENABLED=false
OPIK_URL_OVERRIDE=http://localhost:5173/api
OPIK_PROJECT_NAME=grc-policy-server
OPIK_WORKSPACE=default

# ── Runtime tuning ─────────────────────────────────────────────────────────
DOWNLOAD_TIMEOUT_SECONDS=30
MAX_DOWNLOAD_MB=50
EMBED_BATCH_SIZE=32

# ── Request mutex ───────────────────────────────────────────────────────────
REQUEST_MUTEX_LOCK_FILE=/tmp/grc_policy_server.request.lock
